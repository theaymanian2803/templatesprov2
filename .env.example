# ---------------------------------------------------------------------------
# Environment variables for templateprv2 (Unccodestore)
# Copy to `.env` and fill in real values. `.env` is gitignored — never commit it.
# ---------------------------------------------------------------------------

# --- App / auth -------------------------------------------------------------
# Public base URL of the app (used by Better Auth and trusted origins).
BETTER_AUTH_URL=http://localhost:8080
# Absolute public site origin used for canonical + Open Graph URLs and sitemap.
VITE_SITE_URL=https://unccodestore.com
# Display currency for prices (PayPal settles in USD).
VITE_CURRENCY=USD
# Secret used by Better Auth to sign sessions. Generate a strong 32+ byte value.
BETTER_AUTH_SECRET=
# Email of the account that is automatically granted the admin role on signup.
ADMIN_EMAIL=

# --- Database (Turso / libSQL) ---------------------------------------------
TURSO_URL=
TURSO_AUTH_TOKEN=

# --- Google OAuth (social sign-in) -----------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- PayPal (payments) ------------------------------------------------------
# Server-side credentials.
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
# "sandbox" or "live".
PAYPAL_ENVIRONMENT=sandbox
# Public client id exposed to the browser (same value as PAYPAL_CLIENT_ID).
VITE_PAYPAL_CLIENT_ID=

# --- Cloudflare R2 (image / file uploads) -----------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_DOMAIN=

# --- License issuance server (external) -------------------------------------
# Base URL + shared admin secret for issuing template license keys.
LICENSE_SERVER_URL=
LICENSE_API_SECRET=

# --- Vercel (auto-provided on deploy; leave empty locally) ------------------
# VERCEL_URL=
# VERCEL_BRANCH_URL=
